# Base de dades
DATABASE_URI=mongodb://127.0.0.1/identitatdigital

# Clau de signatura de Payload (mínim 32 caràcters)
# Genera-la amb: openssl rand -base64 48
PAYLOAD_SECRET= 

# URLs de l'aplicació
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Habilita l'API GraphQL (desactivada per defecte)
ENABLE_GRAPHQL=

# MongoDB
MONGODB_MAX_POOL_SIZE=25

# Amfitrions HTTPS externs que next/image pot optimitzar (separats per comes)
MEDIA_REMOTE_HOSTS=

# Només per a desenvolupament: credencials del compte administrador inicial
SEED_ADMIN_EMAIL=admin@identitat.digital
SEED_ADMIN_PASSWORD=
